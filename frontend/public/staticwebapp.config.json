{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_next/*", "/images/*", "/fonts/*", "/models/*", "/*.ico", "/*.png", "/*.svg"]
  },
  "routes": [
    {
      "route": "/saved/*",
      "redirect": "/library/",
      "statusCode": 301
    },
    {
      "route": "/models/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/fonts/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
