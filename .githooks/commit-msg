#!/bin/sh
# Strips tool attribution from commit messages: Co-Authored-By trailers that
# name Claude or anthropic.com, and "Generated with Claude Code" footers.
# Enable once per clone with: git config core.hooksPath .githooks

msg="$1"
tmp="$msg.strip"

grep -viE '^[[:space:]]*co-authored-by:.*(claude|anthropic\.com)|generated with \[?claude code' "$msg" > "$tmp"

# Drop the blank lines the removed trailer leaves at the end.
sed -e ':a' -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmp" > "$msg"
rm -f "$tmp"
